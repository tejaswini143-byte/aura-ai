# Backend
AURA_PUBLIC_BASE_URL=https://YOUR-PUBLIC-HTTPS-URL
DATABASE_PATH=./aura.db
# Outbound calls remain off unless explicitly enabled after provider setup and verification.
AURA_OUTBOUND_CALLS_ENABLED=false
AURA_MAX_CALLS_PER_DAY=3
AURA_MAX_CALL_DURATION_SECONDS=120
# Required for admin access. Generate a unique password of at least 16 characters; intentionally blank, with no default.
AURA_ADMIN_PASSWORD=
AURA_ENVIRONMENT=development
AURA_SESSION_COOKIE_SAMESITE=strict
AURA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional server-to-server action token. Never put this in NEXT_PUBLIC_* or browser code.
AURA_ACTIONS_API_TOKEN=
AURA_PHONE_VERIFICATION_ENABLED=false

# Twilio Programmable Voice — keep these secrets server-side only
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gnani Prisma STT + Timbre TTS. Obtain an API key from Gnani; keep it server-side.
GNANI_API_KEY=
# Choose a valid Timbre v2.5 voice for the configured language from Gnani's voice catalog.
GNANI_TTS_VOICE=Suhana
GNANI_TTS_VOICE_TELUGU=Lehara
GNANI_TTS_VOICE_HINDI=Yashvi
GNANI_TTS_VOICE_ENGLISH=Trupti
GNANI_LANGUAGE=te-IN
# Select "gemini_live" (default) or "gnani"; both require a working public WSS callback.
AURA_VOICE_ENGINE=gemini_live

# DotVoice. Configure only after account-specific API and calling permissions are verified.
DOTVOICE_API_KEY=

# Gemini AI assistant (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# Two independent switches are required before any proactive phone call can occur.
# Also configure AURA_ADMIN_PASSWORD, AURA_ACTIONS_API_TOKEN, Twilio/Gemini credentials,
# a public HTTPS backend URL, explicit saved preferences and a verified destination.
# Both switches remain off by default to prevent unexpected calls or charges.
AURA_PROACTIVE_CALLS_ENABLED=false
